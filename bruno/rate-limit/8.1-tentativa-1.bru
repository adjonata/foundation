meta {
  name: 8.1 Tentativa 1/11 (senha errada) → 401
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{SUPER_ADMIN_EMAIL}}",
    "password": "senha-errada"
  }
}

docs {
  Testa o rate limit de autenticação (server/middleware/03.rate-limit.ts).

  Limite padrão: 10 tentativas por 15 minutos, por IP + rota (ver .env
  AUTH_RATE_LIMIT_MAX / AUTH_RATE_LIMIT_WINDOW). Esta sequência faz 10 tentativas
  de login com senha errada (401 esperado) seguidas de uma 11ª (8.11) que deve
  retornar 429.

  Use "Run Folder" para disparar as 11 requisições em sequência de uma vez.
}
